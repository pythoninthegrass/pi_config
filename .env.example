# lightpanda cloud
LIGHTPANDA_TOKEN="your-token-here"

# omlx server (Mac/Apple Silicon only)
OMLX_BASE_URL="http://127.0.0.1:8000"
OMLX_API_KEY="supersecurepassword"
# set to suppress startup warnings when omlx is unreachable
OMLX_QUIET=1

# pi provider + model — set per machine. This is the BUILDER/startup model only.
# The planner (tab toggle, extensions/plan-mode/index.ts) is fixed at
# github-copilot/claude-opus-4.8 and does not come from these vars.
# mbp/studio: PI_DEFAULT_PROVIDER=omlx,       PI_DEFAULT_MODEL=Qwen3.6-35B-A3B-bf16
# tailnet:    PI_DEFAULT_PROVIDER=aperture,   PI_DEFAULT_MODEL=qwen3.8-flash-next  (mf's llama-swap, routed through the Aperture gateway at http://ai/v1; needs tailnet connectivity)
PI_DEFAULT_PROVIDER="aperture"
PI_DEFAULT_MODEL="qwen3.8-flash-next"
